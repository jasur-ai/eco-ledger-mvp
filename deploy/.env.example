# Nusxa oling: cp deploy/.env.example .env && chmod 600 .env
# ⚠️ Bu fayl repoga tushmaydi (.gitignore da .env bor).

# --- Majburiy ---
ECO_BOT_TOKEN=123456:ABC-DEF...                 # @BotFather'dan; oshkor bo'lsa /revoke
ECO_ADMIN_CHAT_ID=8004724563                    # eskalatsiya xabarlari uchun operator chat

# --- Ixtiyoriy ---
# ECO_LEDGER_DB=/app/data/eco_ledger.db         # SQLite yo'li (docker ichida standalone)
# ECO_API=http://eco-api:8000                   # bot → API manzili
# ECO_ADMIN_CHAT_IDS=123,456                    # bir nechta operator (vergul bilan)
# LLM_API_KEY=sk-...                            # bo'lsa: LLM rejimi; bo'lmasa: deterministik shablon
